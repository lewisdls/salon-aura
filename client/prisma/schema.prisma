generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Appointment {
  id           String   @id @default(uuid())
  client_name  String
  client_phone String
  date         String
  time         String
  service      String
  createdAt    DateTime @default(now())
}

model Service {
  id          String  @id @default(uuid())
  name        String
  price       Int
  description String
  image       String
  isVariable  Boolean @default(false)
}

model Member {
  id    String @id @default(uuid())
  name  String
  role  String
  image String
}

model Drink {
  id          BigInt   @id(map: "Drinks_pkey") @default(autoincrement())
  name        String   @db.VarChar
  description String?
  price       Float
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  category    String?  @db.VarChar
}
